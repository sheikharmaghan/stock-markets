# 11. PIE CHART 3: DAILY PRICE DIRECTION
if close_col is not None:
    close_values = pd.to_numeric(df[close_col], errors="coerce")

    if date_col is not None and symbol_col is not None:
        temp = pd.DataFrame({
            "date": pd.to_datetime(df[date_col], errors="coerce"),
            "symbol": df[symbol_col].astype(str),
            "close": close_values
        }).dropna(subset=["date", "close"])

        temp = temp.sort_values(["symbol", "date"])
        temp["change"] = temp.groupby("symbol")["close"].pct_change()

    elif date_col is not None:
        temp = pd.DataFrame({
            "date": pd.to_datetime(df[date_col], errors="coerce"),
            "close": close_values
        }).dropna(subset=["date", "close"])

        temp = temp.sort_values("date")
        temp["change"] = temp["close"].pct_change()

    else:
        temp = pd.DataFrame({"close": close_values}).dropna()
        temp["change"] = temp["close"].pct_change()

    changes = temp["change"].replace([np.inf, -np.inf], np.nan).dropna()

    if not changes.empty:
        directions = pd.Series(
            np.select(
                [changes > 0, changes < 0],
                ["Positive Change", "Negative Change"],
