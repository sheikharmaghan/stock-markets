    corr.to_csv(f"{OUTPUT_DIR}/correlation_matrix.csv")
else:
    print("Not enough numeric columns for correlation heatmap.")

# 14. SAVE EDA SUMMARY
summary = pd.DataFrame([{
    "Rows": len(df),
    "Columns": len(original_columns),
    "Duplicate Rows": duplicate_count,
