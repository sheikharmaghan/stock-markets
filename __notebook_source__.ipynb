# ============================================================
# PAKISTAN STOCK MARKET - DECISION TREE REGRESSION
# 80% Training | 20% Testing
# ============================================================

import os
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)
import joblib

warnings.filterwarnings("ignore")

# 1. LOAD DATASET
file_path = (
    "/kaggle/input/datasets/fayaznoor10/"
    "pakistan-stock-market-data-20172025/"
    "compiled_psx_historical_2017_2025.csv"
)

df = pd.read_csv(file_path)

print("Dataset loaded successfully!")
print("Original dataset shape:", df.shape)
print("\nColumns:", df.columns.tolist())
print("\nFirst 5 rows:")
display(df.head())

# 2. CLEAN COLUMN NAMES
df.columns = df.columns.str.strip()

# Find target column (closing price)
target_candidates = [
    "close", "closing_price", "close_price",
    "closing price", "close price", "adj_close",
    "adj close", "adjusted_close"
]

normalized_columns = {
    col.lower().strip().replace(" ", "_"): col
    for col in df.columns
}

target_col = None
for candidate in target_candidates:
    if candidate in normalized_columns:
        target_col = normalized_columns[candidate]
        break

if target_col is None:
    raise ValueError(
        "Closing price target column was not found. "
        "Check the printed column names and set target_col manually."
    )

print("\nTarget column:", target_col)

# 3. CLEAN TARGET AND DATA
df = df.replace([np.inf, -np.inf], np.nan)
df[target_col] = pd.to_numeric(df[target_col], errors="coerce")
df = df.dropna(subset=[target_col]).copy()

# Remove duplicate rows
df = df.drop_duplicates().copy()

# 4. PREPARE FEATURES
X = df.drop(columns=[target_col]).copy()
y = df[target_col].copy()

# Convert date/time columns into year, month, day features
for col in X.columns:
    if (
        "date" in col.lower()
        or "time" in col.lower()
    ):
        parsed_date = pd.to_datetime(X[col], errors="coerce")

        if parsed_date.notna().mean() >= 0.5:
            X[col + "_year"] = parsed_date.dt.year
            X[col + "_month"] = parsed_date.dt.month
            X[col + "_day"] = parsed_date.dt.day
            X = X.drop(columns=[col])

# Remove columns that directly reveal the target
# (for example, price change calculated from closing price)
leakage_words = [
    "change", "change_percent", "change_pct",
    "daily_return", "return_percent"
]

leakage_cols = [
    col for col in X.columns
    if any(word in col.lower().replace(" ", "_")
           for word in leakage_words)
]

if leakage_cols:
    print("\nRemoving possible target-leakage columns:", leakage_cols)
    X = X.drop(columns=leakage_cols)

# Remove completely empty columns
X = X.dropna(axis=1, how="all")

# Convert numeric-looking text columns when appropriate
for col in X.columns:
    if X[col].dtype == "object":
        converted = pd.to_numeric(X[col], errors="coerce")
        if converted.notna().mean() >= 0.90:
            X[col] = converted

# Identify feature types
numeric_features = X.select_dtypes(include=["number"]).columns.tolist()
categorical_features = X.select_dtypes(
    include=["object", "category", "bool"]
).columns.tolist()

# 5. PREPROCESSING
numeric_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="median"))
])

categorical_transformer = Pipeline(steps=[
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("onehot", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer(
    transformers=[
        ("numeric", numeric_transformer, numeric_features),
        ("categorical", categorical_transformer, categorical_features)
    ],
    remainder="drop"
)

# 6. SPLIT DATA: 80% TRAINING, 20% TESTING
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.20,
    random_state=42
)

print("\n========== DATA SPLIT ==========")
print("Total usable rows:", len(X))
print("Training rows (80%):", len(X_train))
print("Testing rows (20%):", len(X_test))
print("Number of input features:", X.shape[1])

# 7. BUILD DECISION TREE MODEL
model = Pipeline(steps=[
    ("preprocessor", preprocessor),
    ("decision_tree", DecisionTreeRegressor(
        max_depth=10,
        min_samples_split=10,
        min_samples_leaf=5,
        random_state=42
    ))
])

# 8. TRAIN MODEL USING 80% DATA
model.fit(X_train, y_train)

print("\nDecision Tree model training completed!")

# 9. PREDICT ON THE 20% TEST DATA
y_pred = model.predict(X_test)

# 10. EVALUATE MODEL
mae = mean_absolute_error(y_test, y_pred)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
r2 = r2_score(y_test, y_pred)

print("\n========== MODEL EVALUATION ==========")
print(f"Mean Absolute Error (MAE): {mae:.4f}")
print(f"Root Mean Squared Error (RMSE): {rmse:.4f}")
print(f"R² Score: {r2:.4f}")
print(f"R² Percentage (for reference): {r2 * 100:.2f}%")

# 11. ACTUAL VS PREDICTED TABLE
results = pd.DataFrame({
    "Actual_Closing_Price": y_test.values,
    "Predicted_Closing_Price": y_pred,
    "Absolute_Error": np.abs(y_test.values - y_pred)
})

print("\n========== SAMPLE PREDICTIONS ==========")
display(results.head(10))

# 12. PLOT ACTUAL VS PREDICTED VALUES
plt.figure(figsize=(10, 6))
plt.scatter(y_test, y_pred, alpha=0.5)
min_val = min(y_test.min(), y_pred.min())
max_val = max(y_test.max(), y_pred.max())
plt.plot([min_val, max_val], [min_val, max_val], "r--")
plt.xlabel("Actual Closing Price")
plt.ylabel("Predicted Closing Price")
plt.title("Decision Tree: Actual vs Predicted Closing Price")
plt.tight_layout()
plt.show()

# 13. FEATURE IMPORTANCE
tree_model = model.named_steps["decision_tree"]
feature_names = model.named_steps[
    "preprocessor"
].get_feature_names_out()

importance_df = pd.DataFrame({
    "Feature": feature_names,
    "Importance": tree_model.feature_importances_
}).sort_values("Importance", ascending=False)

print("\n========== TOP 15 IMPORTANT FEATURES ==========")
display(importance_df.head(15))

plt.figure(figsize=(10, 6))
top_features = importance_df.head(15).sort_values("Importance")
plt.barh(top_features["Feature"], top_features["Importance"])
plt.xlabel("Feature Importance")
plt.title("Top 15 Decision Tree Features")
plt.tight_layout()
plt.show()

# 14. SAVE MODEL AND RESULTS
output_dir = "/kaggle/working"
model_path = os.path.join(output_dir, "psx_decision_tree_model.pkl")
predictions_path = os.path.join(output_dir, "psx_test_predictions.csv")
importance_path = os.path.join(output_dir, "psx_feature_importance.csv")

joblib.dump(model, model_path)
results.to_csv(predictions_path, index=False)
importance_df.to_csv(importance_path, index=False)

print("\n========== FILES SAVED ==========")
print("Trained model:", model_path)
print("Test predictions:", predictions_path)
print("Feature importance:", importance_path)
print("\nDone! Download these files from Kaggle's Output section.")




# ============================================
# TEST DECISION TREE ON REMAINING 20% DATA
# ============================================

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score,
    accuracy_score
)
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Predict on the 20% test data
y_pred = model.predict(X_test)

# Regression evaluation metrics
mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
rmse = np.sqrt(mse)
r2 = r2_score(y_test, y_pred)

# Calculate approximate percentage accuracy
# This is a MAPE-based score, not classification accuracy.
y_test_array = np.asarray(y_test)
y_pred_array = np.asarray(y_pred)

nonzero_mask = y_test_array != 0
if nonzero_mask.any():
    mape = np.mean(
        np.abs(
            (y_test_array[nonzero_mask] - y_pred_array[nonzero_mask])
            / y_test_array[nonzero_mask]
        )
    ) * 100
    percentage_accuracy = max(0, 100 - mape)
else:
    mape = np.nan
    percentage_accuracy = np.nan

print("========== TEST RESULTS (20% DATA) ==========")
print("Testing samples:", len(y_test))
print(f"MAE: {mae:.4f}")
print(f"MSE: {mse:.4f}")
print(f"RMSE: {rmse:.4f}")
print(f"R² Score: {r2:.4f}")
print(f"R² (%): {r2 * 100:.2f}%")
print(f"MAPE: {mape:.2f}%")
print(f"Approx. percentage accuracy (100 - MAPE): "
      f"{percentage_accuracy:.2f}%")

# Compare actual and predicted values
test_results = pd.DataFrame({
    "Actual": y_test_array,
    "Predicted": y_pred_array,
    "Absolute_Error": np.abs(y_test_array - y_pred_array)
})

print("\n========== FIRST 20 TEST PREDICTIONS ==========")
display(test_results.head(20))

# Plot actual vs predicted
plt.figure(figsize=(8, 6))
plt.scatter(y_test_array, y_pred_array, alpha=0.6)
low = min(y_test_array.min(), y_pred_array.min())
high = max(y_test_array.max(), y_pred_array.max())
plt.plot([low, high], [low, high], "r--")
plt.xlabel("Actual Closing Price")
plt.ylabel("Predicted Closing Price")
plt.title("Decision Tree - Test Data (20%)")
plt.tight_layout()
plt.show()

# Save test predictions
test_results.to_csv(
    "/kaggle/working/psx_test_predictions.csv",
    index=False
)
print("Saved: /kaggle/working/psx_test_predictions.csv")




import os
import joblib
import pandas as pd
import numpy as np
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# Output folder
output_dir = "/kaggle/working"
os.makedirs(output_dir, exist_ok=True)

# 1. Save the trained Decision Tree model
model_file = os.path.join(output_dir, "psx_decision_tree_model.pkl")
joblib.dump(model, model_file)

# 2. Generate predictions on the remaining 20% test data
y_pred = model.predict(X_test)

# 3. Save actual and predicted values
test_results = pd.DataFrame({
    "Actual": np.asarray(y_test),
    "Predicted": y_pred,
    "Absolute_Error": np.abs(np.asarray(y_test) - y_pred)
})

predictions_file = os.path.join(
    output_dir, "psx_test_predictions.csv"
)
test_results.to_csv(predictions_file, index=False)

# 4. Save evaluation metrics
metrics = pd.DataFrame([{
    "Training_Percentage": 80,
    "Testing_Percentage": 20,
    "Test_Samples": len(y_test),
    "MAE": mean_absolute_error(y_test, y_pred),
    "MSE": mean_squared_error(y_test, y_pred),
    "RMSE": np.sqrt(mean_squared_error(y_test, y_pred)),
    "R2_Score": r2_score(y_test, y_pred)
}])

metrics_file = os.path.join(
    output_dir, "psx_model_evaluation.csv"
)
metrics.to_csv(metrics_file, index=False)

# 5. Confirm saved files
print("All files saved successfully!")
print("\nModel:", model_file)
print("Test predictions:", predictions_file)
print("Evaluation metrics:", metrics_file)

print("\nModel evaluation:")
display(metrics)

print("\nSample test predictions:")
display(test_results.head())




