# 7. IDENTIFY IMPORTANT COLUMNS
def find_column(keywords, columns):
    for col in columns:
        name = str(col).strip().lower().replace(" ", "_")
        if name in keywords:
            return col

    for col in columns:
        name = str(col).strip().lower().replace(" ", "_")
        if any(keyword in name for keyword in keywords):
            return col

    return None

