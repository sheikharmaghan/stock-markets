# 13. CORRELATION HEATMAP
print("\n8. CORRELATION HEATMAP")

if numeric_df.shape[1] >= 2:
    corr = numeric_df.corr(numeric_only=True)

    fig, ax = plt.subplots(figsize=(12, 9))
